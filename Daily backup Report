USE dbadb;
GO

-- One-time table setup
IF OBJECT_ID('dbo.Staging_BackupReport','U') IS NULL
    CREATE TABLE dbo.Staging_BackupReport (
        ServerName       NVARCHAR(256),
        DatabaseName     NVARCHAR(256),
        RecoveryMode     NVARCHAR(60),
