-- ============================================================
-- CREATE THE AGENT JOB
-- ============================================================
USE msdb;
GO

BEGIN TRANSACTION;

DECLARE @jobId   UNIQUEIDENTIFIER;
DECLARE @schedId UNIQUEIDENTIFIER;

-- Create the job
EXEC sp_add_job
    @job_name        = N'Daily Backup Health Report',
    @enabled         = 1,
    @description     = N'Collects backup status from all 09-Production servers and emails an HTML report flagging any DB missing a Full backup in the last 24 hours.',
    @category_name   = N'Database Maintenance',
    @notify_level_eventlog = 2,   -- log on failure
    @job_id          = @jobId OUTPUT;

-- ============================================================
-- STEP 1: Collect data from all registered production servers
-- This step runs as a CMS "multi-server" query.
-- Set this step's "Run on:" to your 09-Production server group
-- in the job step properties after creation.
-- ============================================================
EXEC sp_add_jobstep
    @job_id          = @jobId,
    @step_name       = N'Collect Backup Data From All Servers',
    @step_id         = 1,
    @subsystem       = N'TSQL',
    @database_name   = N'dbadb',    -- on each TARGET server, write to master CMS db via linked server
    @command         = N'
-- This query runs on EVERY server in the 09-Production CMS group.
-- Results are automatically collected back to the master server.

-- Clear today''s data for this server only
DELETE FROM [agdw19prd001\sqlprd001].dbadb.dbo.Staging_BackupReport
WHERE ServerName = CAST(SERVERPROPERTY(''ServerName'') AS NVARCHAR(256));

-- Insert this server''s backup summary
INSERT INTO [agdw19prd001\sqlprd001].dbadb.dbo.Staging_BackupReport
    (ServerName, DatabaseName, RecoveryMode, LastFullBackup, LastDifferential, LastLog, CollectedAt)
SELECT 
    CAST(SERVERPROPERTY(''ServerName'') AS NVARCHAR(256))                  AS ServerName,
    db.name                                                                 AS DatabaseName,
    db.recovery_model_desc                                                  AS RecoveryMode,
    MAX(CASE WHEN bs.type = ''D'' THEN bs.backup_finish_date ELSE NULL END) AS LastFullBackup,
    MAX(CASE WHEN bs.type = ''I'' THEN bs.backup_finish_date ELSE NULL END) AS LastDifferential,
    MAX(CASE WHEN bs.type = ''L'' THEN bs.backup_finish_date ELSE NULL END) AS LastLog,
    GETDATE()                                                               AS CollectedAt
FROM 
    master.sys.databases db
    LEFT JOIN (
        msdb.dbo.backupmediafamily bmf
        INNER JOIN msdb.dbo.backupset bs 
            ON  bmf.media_set_id = bs.media_set_id
            AND (   bmf.physical_device_name LIKE ''\\ny.state.ny.us\%''
                 OR bmf.physical_device_name LIKE ''\\nyofsprd616\%'')
    ) ON db.name = bs.database_name
WHERE 
    db.state_desc = ''ONLINE''
    AND db.name != ''tempdb''
GROUP BY 
    db.name,
    db.recovery_model_desc;
',
    @on_success_action = 3,   -- go to next step
    @on_fail_action    = 3;   -- go to next step (so email still fires even if one server is down)

-- ============================================================
-- STEP 2: Build HTML report and send email
-- This step runs on the CMS master server only.
-- ============================================================
EXEC sp_add_jobstep
    @job_id        = @jobId,
    @step_name     = N'Send HTML Backup Report Email',
    @step_id       = 2,
    @subsystem     = N'TSQL',
    @database_name = N'dbadb',
    @command       = N'
USE dbadb;

DECLARE @html       NVARCHAR(MAX);
DECLARE @subject    NVARCHAR(500);
DECLARE @alertCount INT;
DECLARE @totalCount INT;
DECLARE @runDate    NVARCHAR(30) = CONVERT(NVARCHAR, GETDATE(), 107); -- "Mar 15, 2026"

-- Count alerts (ONLINE DBs with no Full backup to our paths in last 24 hrs)
SELECT @alertCount = COUNT(*)
FROM   dbo.Staging_BackupReport
WHERE  (LastFullBackup IS NULL OR LastFullBackup < DATEADD(HOUR, -24, GETDATE()));

SELECT @totalCount = COUNT(*) FROM dbo.Staging_BackupReport;

-- Subject line flags immediately whether anything is wrong
SET @subject = CASE 
    WHEN @alertCount > 0 
    THEN ''⚠️ BACKUP ALERT ['' + CAST(@alertCount AS NVARCHAR) + '' DB(s) at risk] — '' + @runDate
    ELSE ''✅ All Backups Healthy — '' + @runDate
END;

-- ── Build HTML ──────────────────────────────────────────────
SET @html = N''
<!DOCTYPE html>
<html>
<head>
<style>
  body        { font-family: Segoe UI, Arial, sans-serif; font-size: 13px; color: #333; }
  h2          { color: #1a3c6e; }
  .summary    { margin-bottom: 16px; }
  table       { border-collapse: collapse; width: 100%; }
  th          { background-color: #1a3c6e; color: white; padding: 8px 12px; text-align: left; }
  td          { padding: 7px 12px; border-bottom: 1px solid #ddd; }
  tr:hover td { background-color: #f0f4ff; }
  .alert      { background-color: #fff0f0 !important; font-weight: bold; color: #c0000c; }
  .ok         { color: #1a7a1a; }
  .never      { color: #c0000c; font-style: italic; }
  .footer     { font-size: 11px; color: #888; margin-top: 20px; }
</style>
</head>
<body>
<h2>📊 Daily Backup Health Report — '' + @runDate + ''</h2>
<div class="summary">
  <b>Total Databases Monitored:</b> '' + CAST(@totalCount AS NVARCHAR) + '' &nbsp;|&nbsp;
  <b>At Risk (Full &gt; 24hrs or Never Backed Up):</b> 
  <span style="color:'' + CASE WHEN @alertCount > 0 THEN ''#c0000c'' ELSE ''#1a7a1a'' END + ''; font-weight:bold;">
    '' + CAST(@alertCount AS NVARCHAR) + ''
  </span>
</div>
<table>
  <thead>
    <tr>
      <th>Server</th>
      <th>Database</th>
      <th>Recovery Mode</th>
      <th>Last Full Backup</th>
      <th>Last Differential</th>
      <th>Last Log Backup</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>'';

-- Append one row per database, alerts sorted to top
SELECT @html = @html +
    N''<tr class="'' + 
        CASE WHEN (LastFullBackup IS NULL OR LastFullBackup < DATEADD(HOUR,-24,GETDATE())) 
             THEN ''alert'' ELSE '''' END + ''">
      <td>'' + ISNULL(ServerName,   ''Unknown'') + ''</td>
      <td>'' + ISNULL(DatabaseName, ''Unknown'') + ''</td>
      <td>'' + ISNULL(RecoveryMode, ''Unknown'') + ''</td>
      <td class="'' + CASE WHEN LastFullBackup IS NULL THEN ''never'' 
                           WHEN LastFullBackup < DATEADD(HOUR,-24,GETDATE()) THEN ''alert'' 
                           ELSE ''ok'' END + ''">
           '' + ISNULL(CONVERT(NVARCHAR,LastFullBackup,120), ''⚠ Never'') + ''</td>
      <td>'' + ISNULL(CONVERT(NVARCHAR,LastDifferential,120),''—'') + ''</td>
      <td>'' + ISNULL(CONVERT(NVARCHAR,LastLog,120),''—'') + ''</td>
      <td>'' + CASE WHEN (LastFullBackup IS NULL OR LastFullBackup < DATEADD(HOUR,-24,GETDATE()))
                   THEN ''⚠️ AT RISK'' ELSE ''✅ OK'' END + ''</td>
    </tr>''
FROM dbo.Staging_BackupReport
ORDER BY 
    -- Alerts first, then by server/db
    CASE WHEN (LastFullBackup IS NULL OR LastFullBackup < DATEADD(HOUR,-24,GETDATE())) THEN 0 ELSE 1 END,
    ServerName,
    DatabaseName;

SET @html = @html + N''
  </tbody>
</table>
<div class="footer">
  Report generated at '' + CONVERT(NVARCHAR, GETDATE(), 120) + '' by SQL Server Agent on agdw19prd001\sqlprd001.<br>
  Backup paths monitored: \\ny.state.ny.us\... and \\nyofsprd616\...
</div>
</body>
</html>'';

-- ── Send the email ───────────────────────────────────────────
EXEC msdb.dbo.sp_send_dbmail
    @profile_name  = N''DBA Alerts'',       -- ← replace with your mail profile name
    @recipients    = N''dba-team@ny.state.ny.us'',  -- ← replace with your distribution list
    @subject       = @subject,
    @body          = @html,
    @body_format   = N''HTML'';
',
    @on_success_action = 1,   -- quit with success
    @on_fail_action    = 2;   -- quit with failure

-- ============================================================
-- SCHEDULE: Every day at 7:00 AM
-- ============================================================
EXEC sp_add_schedule
    @schedule_name      = N'Daily 7AM',
    @freq_type          = 4,       -- daily
    @freq_interval      = 1,
    @active_start_time  = 070000,  -- 07:00:00
    @schedule_id        = @schedId OUTPUT;

EXEC sp_attach_schedule
    @job_id      = @jobId,
    @schedule_id = @schedId;

-- Attach job to the local server (CMS master)
EXEC sp_add_jobserver
    @job_id      = @jobId,
    @server_name = N'(local)';

COMMIT TRANSACTION;
GO
