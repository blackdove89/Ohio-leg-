--Users & Role Membership (Matric1)
USE Matric1;
GO
SET NOCOUNT ON;

SELECT
    dp.name AS UserName,
    dp.type_desc AS UserType,
    dr.name AS RoleName
FROM sys.database_principals dp
LEFT JOIN sys.database_role_members drm
    ON dp.principal_id = drm.member_principal_id
LEFT JOIN sys.database_principals dr
    ON drm.role_principal_id = dr.principal_id
WHERE dp.type IN ('S','U','G')
AND dp.name NOT IN ('dbo','guest','sys','INFORMATION_SCHEMA')
ORDER BY dp.name, dr.name;
-----------------------------
--Explicit Permissions (Matric1)
USE Matric1;
GO
SET NOCOUNT ON;

SELECT
    pr.name AS UserName,
    pr.type_desc AS UserType,
    pe.permission_name,
    pe.state_desc,
    OBJECT_SCHEMA_NAME(pe.major_id) AS SchemaName,
    OBJECT_NAME(pe.major_id) AS ObjectName
FROM sys.database_permissions pe
JOIN sys.database_principals pr
    ON pe.grantee_principal_id = pr.principal_id
WHERE pr.name NOT IN ('dbo','guest','sys','INFORMATION_SCHEMA')
ORDER BY pr.name, pe.permission_name;
----------------------------
--
SELECT
    @@SERVERNAME AS ServerName,
    DB_NAME() AS DatabaseName,
    pr.name AS UserName,
    pr.type_desc AS UserType,
    pe.class_desc AS PermissionClass,     -- DATABASE / SCHEMA / OBJECT_OR_COLUMN
    pe.permission_name,
    pe.state_desc,
    CASE 
        WHEN pe.class_desc = 'OBJECT_OR_COLUMN' THEN OBJECT_SCHEMA_NAME(pe.major_id)
        WHEN pe.class_desc = 'SCHEMA' THEN SCHEMA_NAME(pe.major_id)
        ELSE NULL
    END AS ScopeSchema,
    CASE 
        WHEN pe.class_desc = 'OBJECT_OR_COLUMN' THEN OBJECT_NAME(pe.major_id)
        ELSE NULL
    END AS ScopeObject
FROM sys.database_permissions pe
JOIN sys.database_principals pr
    ON pe.grantee_principal_id = pr.principal_id
WHERE pr.name NOT IN ('dbo','guest','sys','INFORMATION_SCHEMA')
ORDER BY pr.name, pe.class_desc, pe.permission_name, pe.state_desc, ScopeSchema, ScopeObject;
