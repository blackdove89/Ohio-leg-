--Job steps (subsystem, db, proxy, actions)
SET NOCOUNT ON;

SELECT
  Category='JobStep',
  ItemKey = CONCAT(j.name,'|Step',js.step_id,'|',js.step_name),
  Property='subsystem/db/proxy/success/fail',
  Value = CONCAT(js.subsystem,'|',COALESCE(js.database_name,''),'|',COALESCE(CONVERT(varchar(10),js.proxy_id),''),
                 '|S:',js.on_success_action,'|F:',js.on_fail_action)
FROM msdb.dbo.sysjobsteps js
JOIN msdb.dbo.sysjobs j ON js.job_id = j.job_id
ORDER BY j.name, js.step_id;
