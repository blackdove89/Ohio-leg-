SELECT @@SERVERNAMe,
    db.name AS DatabaseName,
    CAST(SUM(mf.size) * 8 / 1024.0 AS DECIMAL(10,2)) AS TotalSizeMB,
    CAST(SUM(CASE WHEN mf.type_desc = 'ROWS' THEN mf.size END) * 8 / 1024.0 AS DECIMAL(10,2)) AS DataSizeMB,
    CAST(SUM(CASE WHEN mf.type_desc = 'LOG' THEN mf.size END) * 8 / 1024.0 AS DECIMAL(10,2)) AS LogSizeMB
FROM sys.databases db
JOIN sys.master_files mf 
    ON db.database_id = mf.database_id
GROUP BY db.name
ORDER BY TotalSizeMB DESC;
