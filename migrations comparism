--Command checksum (detect silent drift)
SET NOCOUNT ON;

SELECT
  Category='JobStepCommand',
  ItemKey = CONCAT(j.name,'|Step',js.step_id,'|',js.step_name),
  Property='command_checksum',
  Value = CONVERT(varchar(50), CHECKSUM(js.command))
FROM msdb.dbo.sysjobsteps js
JOIN msdb.dbo.sysjobs j ON js.job_id = j.job_id
ORDER BY j.name, js.step_id;
