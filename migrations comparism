--SSISDB (Folders/Projects/Environments/References)
/* Run these on both servers in SSISDB.
5.1 Folders + projects*/
USE SSISDB;
SET NOCOUNT ON;

SELECT
  Category='SSIS|Folder',
  ItemKey=f.name,
  Property='description',
  Value=COALESCE(f.description,'')
FROM catalog.folders f
UNION ALL
SELECT
  'SSIS|Project',
  CONCAT(f.name,'|',p.name),
  'deployed_by/deployed_time',
  CONCAT(COALESCE(p.deployed_by_name,''),'|',CONVERT(varchar(19),p.deployed_time,120))
FROM catalog.projects p
JOIN catalog.folders f ON p.folder_id=f.folder_id
ORDER BY 1,2,3;
--------------------------------------------------
--Environments + variables (sensitive masked)
USE SSISDB;
SET NOCOUNT ON;

SELECT
  Category='SSIS|EnvVar',
  ItemKey=CONCAT(f.name,'|',e.name,'|',v.name),
  Property='type/sensitive/value',
  Value=CONCAT(v.type,'|',v.sensitive,'|',
               CASE WHEN v.sensitive=1 THEN '<SENSITIVE>'
                    ELSE COALESCE(CONVERT(varchar(4000),v.value),'<NULL>') END)
FROM catalog.environment_variables v
JOIN catalog.environments e ON v.environment_id=e.environment_id
JOIN catalog.folders f ON e.folder_id=f.folder_id
ORDER BY 1,2,3;
--------------------------------------------------
--Project → Environment references
USE SSISDB;
SET NOCOUNT ON;

SELECT
  Category='SSIS|EnvReference',
  ItemKey=CONCAT(f.name,'|',p.name,'|',er.environment_name),
  Property='reference_type',
  Value=CONVERT(varchar(10),er.reference_type)
FROM catalog.environment_references er
JOIN catalog.projects p ON er.project_id=p.project_id
JOIN catalog.folders f ON p.folder_id=f.folder_id
ORDER BY 1,2,3;
