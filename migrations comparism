--Identify the actual “extra” permission rows (SAFE)
USE Matric1;
GO
SET NOCOUNT ON;

SELECT
    pr.name AS UserName,
    pr.type_desc AS UserType,
    pe.class_desc,
    pe.permission_name,
    pe.state_desc,
    CASE 
        WHEN pe.class_desc = 'OBJECT_OR_COLUMN' THEN OBJECT_SCHEMA_NAME(pe.major_id)
        WHEN pe.class_desc = 'SCHEMA' THEN SCHEMA_NAME(pe.major_id)
        ELSE NULL
    END AS ScopeSchema,
    CASE 
        WHEN pe.class_desc = 'OBJECT_OR_COLUMN' THEN OBJECT_NAME(pe.major_id)
        ELSE NULL
    END AS ScopeObject
FROM sys.database_permissions pe
JOIN sys.database_principals pr
  ON pe.grantee_principal_id = pr.principal_id
WHERE pr.name NOT IN ('dbo','guest','sys','INFORMATION_SCHEMA')
  AND pe.permission_name IN (
      'CONTROL','ALTER','ALTER ANY USER','ALTER ANY ROLE','ALTER ANY SCHEMA',
      'IMPERSONATE','TAKE OWNERSHIP','VIEW DEFINITION','EXECUTE'
  )
ORDER BY pr.name, pe.permission_name, pe.state_desc, ScopeSchema, ScopeObject;
