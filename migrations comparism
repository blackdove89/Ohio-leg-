--Linked server login mappings (people forget this)
SET NOCOUNT ON;

SELECT
  Category='LinkedServerLogin',
  ItemKey = CONCAT(s.name,'|Local:',COALESCE(sp.name,'(NULL)')),
  Property='uses_self/remote_name',
  Value = CONCAT(lsl.uses_self_credential,'|',COALESCE(lsl.remote_name,''))
FROM sys.servers s
JOIN sys.linked_logins lsl ON s.server_id = lsl.server_id
LEFT JOIN sys.server_principals sp ON lsl.local_principal_id = sp.principal_id
WHERE s.is_linked = 1
ORDER BY s.name, sp.name;
