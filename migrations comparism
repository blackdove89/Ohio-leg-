--Users & Role Membership (Matric1)
USE Matric1;
GO
SET NOCOUNT ON;

SELECT
    dp.name AS UserName,
    dp.type_desc AS UserType,
    dr.name AS RoleName
FROM sys.database_principals dp
LEFT JOIN sys.database_role_members drm
    ON dp.principal_id = drm.member_principal_id
LEFT JOIN sys.database_principals dr
    ON drm.role_principal_id = dr.principal_id
WHERE dp.type IN ('S','U','G')
AND dp.name NOT IN ('dbo','guest','sys','INFORMATION_SCHEMA')
ORDER BY dp.name, dr.name;
