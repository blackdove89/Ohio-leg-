--Use this to export the logins, this sets the paramenter
-- Set Variables (what you need)
$instance        = "TestServer\Instance"
$exportFolder    = "C:\Temp\dbatools-login-reset"
$timestamp       = (Get-Date -Format "yyyyMMdd-HHmmss")
$exportLoginFile = Join-Path $exportFolder "logins-$($timestamp).sql"
$exportRoleFile  = Join-Path $exportFolder "server-roles-$($timestamp).sql"
$exportPermFile  = Join-Path $exportFolder "server-permissions-$($timestamp).sql"

--Confirm if folder exist 
New-Item -ItemType Directory -Path $exportFolder -Force

--Test if the folder get created (result should be true)
Test-Path $exportFolder
