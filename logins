--To clear logins at once
$instance 	 = "complete/servername"

--List logins to keep if any 
$keep = @('AGUSER', 'OH\DBAteam','OH\AKjjm')

--View logins to be deleted 
Get-DbaLogin -SqlInstance $instance -ExcludeSystemLogins | Where-Object { $_.Name -notin $keep } |
Remove-DbaLogin -WhatIf -Confirm:$false

--Delete logins, check first 
Get-DbaLogin -SqlInstance $instance -ExcludeSystemLogins | Where-Object { $_.Name -notin $keep } |
Remove-DbaLogin -WhatIf -Confirm:$false

--Delete logins
Get-DbaLogin -SqlInstance $instance -ExcludeSystemLogins | Where-Object { $_.Name -notin $keep } |
Remove-DbaLogin -Confirm:$false

